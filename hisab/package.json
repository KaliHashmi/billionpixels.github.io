{
  "name": "hisab",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start:uat": "APP_VARIANT=uat expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "build:uat": "eas build --profile uat --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:prod": "eas submit --profile production --platform all",
    "lint": "expo lint",
    "verify": "npm run typecheck && npm run lint && npm test -- --ci && node --test scripts/impact.test.mjs",
    "impact": "node scripts/impact.mjs",
    "build:web": "bash scripts/build-web.sh",
    "build:e2e": "APP_VARIANT=uat CI=1 expo export --platform web --output-dir dist --clear",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:perf": "jest --ci --testMatch '**/__tests__/**/*.perf.ts'",
    "postinstall": "node scripts/vendor-ocr.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@tesseract.js-data/ara": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "^14.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
