{
  "name": "hisab",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@types/jest": "^30.0.0",
    "expo": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-linking": "~58.0.14",
    "expo-print": "~58.0.7",
    "expo-router": "~58.0.27",
    "expo-sharing": "~58.0.20",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "start:uat": "APP_VARIANT=uat expo start",
    "start:prod": "APP_VARIANT=production expo start",
    "build:uat": "eas build --profile uat --platform all",
    "build:prod": "eas build --profile production --platform all",
    "submit:prod": "eas submit --profile production --platform all",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
